# Supabase (admin-web loads these from the repo root; VITE_ names are optional overrides)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database password (Dashboard → Project Settings → Database). Required for `npm run db:migrate`.
SUPABASE_DB_PASSWORD=
# One-time per machine: supabase link --project-ref <subdomain from SUPABASE_URL> -p "$SUPABASE_DB_PASSWORD" --yes

# Teltech
TELTECH_API_AUTH=Bearer your-teltech-auth-token

# Sola Payments (Cardknox)
SOLA_API_KEY=your-sola-api-key

# Rye (environment auto-detected from API key format: RYE/staging-... or RYE/production-...)
RYE_API_KEY=your-rye-api-key

# Rainforest API (Amazon product lookup for Add Product + IVR review lookup)
RAINFOREST_API_KEY=your-rainforest-api-key

# Google
GOOGLE_ADDRESS_VALIDATION_API_KEY=your-google-api-key

# App
API_PORT=3001
API_BASE_URL=http://localhost:3001
ADMIN_URL=http://localhost:5173
DEFAULT_MARKUP_PERCENT=15

# Subscriptions (required before pg_cron jobs can call the API)
# Generate a long random string; use the same value in Supabase private.cron_settings.
CRON_SECRET=your-long-random-cron-secret
# After setting CRON_SECRET, run in Supabase SQL editor (use your public API URL, not localhost):
#   insert into private.cron_settings(key, value) values
#     ('api_base_url', 'https://your-public-api-domain'),
#     ('cron_secret',  'your-long-random-cron-secret')
#   on conflict (key) do update set value = excluded.value;
# Optional tuning for the in-process processing worker.
SUBSCRIPTION_PROCESS_SPACING_MS=4000
SUBSCRIPTION_WORKER_POLL_MS=15000
